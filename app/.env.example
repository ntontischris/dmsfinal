# Μεταβλητές του περιβάλλοντος. Οι τιμές γράφονται μόνο στο Vercel και στο τοπικό .env.local (δεν μπαίνουν εδώ).
# Η σύνδεση με τη βάση (γράφεται από την ενσωμάτωση Supabase ↔ Vercel)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Email (Resend): κλειδί και αποστολέας· προαιρετικό EMAIL_ALLOWED_DOMAINS (π.χ. devremedia.com) για περιορισμό παραληπτών
RESEND_API_KEY=
RESEND_FROM_EMAIL=
EMAIL_ALLOWED_DOMAINS=
# Send Email Hook της Supabase (υπογραφή standard-webhooks, μορφή v1,whsec_...)
SEND_EMAIL_HOOK_SECRET=
# Προαιρετικό: η διεύθυνση της εφαρμογής για τους συνδέσμους στα email (αλλιώς η διεύθυνση του Vercel)
APP_ORIGIN=
# Το Vercel Cron στέλνει αυτό ως Bearer στο /api/cron/outbox
CRON_SECRET=
